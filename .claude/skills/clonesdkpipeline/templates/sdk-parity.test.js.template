// 9. output_router CodeExecutionNode
// ════════════════════════════════════════════════════════════════════

describe('output_router — parity', () => {
  test('has 8 strong_output_leak_markers (SDK count)', () => assert.equal(STRONG_OUTPUT_LEAK_MARKERS.length, 8));
  test('has 11 output_drop_patterns (SDK count)',       () => assert.equal(OUTPUT_DROP_PATTERNS.length, 11));

  test('is_blocked=true → returns blockMessage', () => {
    const res = runOutputRouter({ isBlocked: 'true', blockMessage: 'BLOCKED', report: 'ignored' });
    assert.equal(res.final_output, 'BLOCKED');
  });

  test('strong leak → fallback message', () => {
    const res = runOutputRouter({ isBlocked: 'false', blockMessage: '', report: '## Mental Model\nbody' });
    assert.equal(res.final_output, PROCESS_LEAK_FALLBACK_MESSAGE);
  });

  test('"Thought Process:" header stripped', () => {
    const out = sanitizeReportOutput('## Clean\nbody1\n## Thought Process\nleaked\n## Other\nbody2');
    assert.ok(!out.toLowerCase().includes('thought process'));
    assert.ok(out.includes('Clean'));
    assert.ok(out.includes('Other'));
  });

  test('"STEP 1: Identify" analytic header stripped', () => {
    const out = sanitizeReportOutput('STEP 1: Identify the gap\nbody');
    assert.ok(!out.includes('STEP 1'));
  });

  test('biological "step by step" preserved', () => {
    const out = sanitizeReportOutput('Step by step, the AMPK pathway activates when AMP rises.');
    assert.ok(out.length > 0);
  });

  test('(The X Gap) parenthetical stripped', () => {
    const out = sanitizeReportOutput('TB-500 (The Migration Gap) complements BPC-157.');
    assert.ok(!out.includes('The Migration Gap'));
    assert.ok(out.includes('TB-500'));
  });
});

