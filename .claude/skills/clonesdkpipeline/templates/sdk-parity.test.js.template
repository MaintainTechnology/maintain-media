// 1. ip_guard LlmNode — Anthropic classifier
// ════════════════════════════════════════════════════════════════════

describe('ip_guard — LlmNode parity', () => {
  test('provider is anthropic',            () => assert.equal(IP_GUARD_CONFIG.provider, 'anthropic'));
  test('model is <SDK value>',             () => assert.equal(IP_GUARD_CONFIG.model, 'claude-haiku-4-5-20251001'));
  test('temperature is 0',                 () => assert.equal(IP_GUARD_CONFIG.temperature, 0));
  test('max_tokens is 256',                () => assert.equal(IP_GUARD_CONFIG.max_tokens, 256));
  test('thinking_token_limit is 4096',     () => assert.equal(IP_GUARD_CONFIG.thinking_token_limit, 4096));
  test('max_retries is 1',                 () => assert.equal(IP_GUARD_CONFIG.max_retries, 1));
  test('retry_on_failure is false',        () => assert.equal(IP_GUARD_CONFIG.retry_on_failure, false));
  test('json_response is true',            () => assert.equal(IP_GUARD_CONFIG.json_response, true));
  test('enable_web_search is false',       () => assert.equal(IP_GUARD_CONFIG.enable_web_search, false));
  test('use_personal_api_key is true',     () => assert.equal(IP_GUARD_CONFIG.use_personal_api_key, true));
  test('node_name is ip_guard',            () => assert.equal(IP_GUARD_CONFIG.node_name, 'ip_guard'));

  test('Anthropic request body preserves SDK fields', () => {
    const req = _buildAnthropicRequest('test');
    assert.equal(req.model, IP_GUARD_CONFIG.model);
    assert.equal(req.temperature, 0);
    assert.equal(req.max_tokens, 256);
    assert.equal(req.system, IP_GUARD_SYSTEM);
    assert.equal(req.messages[0].role, 'user');
  });
});

