#!/usr/bin/env node
/**
 * Preflight check — verifies every required env var is set before boot.
 * Exit code 0 = ready. Non-zero = missing config.
 *
 * CUSTOMIZE: edit the REQUIRED array below with the env vars YOUR pipeline
 * needs (typically VECTORSHIFT_API_KEY + one ANTHROPIC_* or GOOGLE_* per
 * LlmNode + one KB_*_ID per KnowledgeBaseNode + ADMIN_API_KEY).
 */

import 'dotenv/config';

const REQUIRED = [
  { key: 'VECTORSHIFT_API_KEY',                              why: 'KB retrieval.' },
  { key: 'ANTHROPIC_API_KEY_<PIPELINE>',                     why: 'LlmNode with provider=anthropic.' },
  { key: 'GOOGLE_AI_KEY_<PIPELINE>',                         why: 'LlmNode with provider=google.' },
  { key: 'KB_INTERVENTION_ID', defaultOk: '<SDK_KB_ID>',     why: 'knowledge_base_0.' },
  { key: 'KB_PATHWAY_ID',      defaultOk: '<SDK_KB_ID>',     why: 'knowledge_base_1.' },
  { key: 'KB_BIOMARKER_ID',    defaultOk: '<SDK_KB_ID>',     why: 'knowledge_base_2.' },
  { key: 'ADMIN_API_KEY',                                    why: 'Issue/revoke consumer API keys. Rotate for production.' },
];

const OPTIONAL = [
  { key: 'PORT',                      default: '3200' },
  { key: 'NODE_ENV',                  default: 'development' },
  { key: 'MAX_CONCURRENT_PIPELINES',  default: '5' },
  { key: 'DATA_DIR',                  default: 'data' },
];

const c = {
  red: '\x1b[31m', green: '\x1b[32m', yellow: '\x1b[33m', cyan: '\x1b[36m',
  dim: '\x1b[2m', bold: '\x1b[1m', reset: '\x1b[0m',
};

console.log(`\n${c.bold}Preflight Check${c.reset}\n${c.dim}${'─'.repeat(40)}${c.reset}\n`);

let missing = 0, warnings = 0;
console.log(`${c.bold}Required:${c.reset}`);
for (const { key, why, defaultOk } of REQUIRED) {
  const value = process.env[key];
  if (!value) {
    console.log(`  ${c.red}✗${c.reset} ${c.bold}${key}${c.reset}  ${c.dim}(${why})${c.reset}`);
    missing++;
  } else if (key === 'ADMIN_API_KEY' && /change.?me/i.test(value)) {
    console.log(`  ${c.yellow}⚠${c.reset} ${c.bold}${key}${c.reset}  ${c.yellow}still default — rotate for production${c.reset}`);
    warnings++;
  } else if (defaultOk && value === defaultOk) {
    console.log(`  ${c.green}✓${c.reset} ${c.bold}${key}${c.reset}  ${c.dim}= ${value} (SDK default)${c.reset}`);
  } else {
    const masked = key.includes('KEY') || key.includes('SECRET')
      ? `${value.slice(0, 8)}...${value.slice(-4)}` : value;
    console.log(`  ${c.green}✓${c.reset} ${c.bold}${key}${c.reset}  ${c.dim}= ${masked}${c.reset}`);
  }
}

console.log(`\n${c.bold}Optional:${c.reset}`);
for (const { key, default: def } of OPTIONAL) {
  const value = process.env[key] || def;
  const tag = process.env[key] ? '' : `${c.dim}(default)${c.reset}`;
  console.log(`  ${c.cyan}·${c.reset} ${key.padEnd(32)} ${c.dim}= ${value}${c.reset} ${tag}`);
}

console.log(`\n${c.bold}Node:${c.reset}     ${process.version}`);
console.log(`${c.bold}Platform:${c.reset} ${process.platform} ${process.arch}`);

if (missing > 0) {
  console.log(`\n${c.red}${c.bold}✗ ${missing} required env var(s) missing.${c.reset}`);
  console.log(`${c.dim}Set with: railway variables set KEY=value${c.reset}\n`);
  process.exit(1);
}
if (warnings > 0) {
  console.log(`\n${c.yellow}${c.bold}⚠ ${warnings} warning(s) — review before production.${c.reset}\n`);
} else {
  console.log(`\n${c.green}${c.bold}✓ Ready to deploy.${c.reset}\n`);
}
process.exit(0);
